<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ShineYamamoto.LessonManagerApp.reservation.repository.ReservationLockMapper">

	<select id="lock" resultType="java.lang.Integer">
		SELECT lock_id
		FROM reservation_lock
		WHERE lock_id = 1
		FOR UPDATE
	</select>
</mapper>